generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum TaskStatus {
  backlog
  todo
  in_progress
  in_review
  done
}

enum TaskPriority {
  none
  low
  medium
  high
  urgent
}

enum TaskType {
  task
  bug
  story
  epic
}

model Project {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  color     String   @default("#6366f1")
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())

  repoUrl       String?
  repoLocalPath String?
  defaultBranch String  @default("main")

  jiraSite       String?
  jiraProjectKey String?

  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId String?

  tasks     Task[]
  labels    Label[]
  workflows Workflow[]
  nextTaskNumber Int @default(1)

  @@index([categoryId])
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#6366f1")
  order     Int      @default(0)
  createdAt DateTime @default(now())

  projects  Project[]
}

model Task {
  id          String       @id @default(cuid())
  number      Int
  title       String
  description String       @default("")
  status      TaskStatus   @default(backlog)
  priority    TaskPriority @default(none)
  type        TaskType     @default(task)
  estimate    Int?
  dueDate     DateTime?
  order       Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  planning    String?

  jiraKey     String?
  jiraUrl     String?

  prUrl       String?

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String

  labels      TaskLabel[]
  workflowRuns WorkflowRun[]

  @@unique([projectId, number])
  @@index([projectId, status])
}

model Label {
  id        String      @id @default(cuid())
  name      String
  color     String      @default("#64748b")

  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  tasks     TaskLabel[]

  @@unique([projectId, name])
}

model TaskLabel {
  task    Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId  String
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)
  labelId String

  @@id([taskId, labelId])
}

enum WorkflowStepType {
  ai_step
  condition
  action
  planning
}

enum WorkflowRunStatus {
  pending
  running
  success
  failed
  cancelled
  crashed
  paused
}

model Workflow {
  id          String   @id @default(cuid())
  name        String
  active      Boolean  @default(true)
  triggerType String   @default("manual")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String

  steps       WorkflowStep[]
  runs        WorkflowRun[]

  @@index([projectId])
}

model WorkflowStep {
  id         String           @id @default(cuid())
  order      Int              // sibling order — position among steps sharing the same parent
  type       WorkflowStepType
  name       String
  enabled    Boolean          @default(true)
  config     String           @default("{}")
  // Pauses the run right after this step finishes, before it recurses into
  // children, so a human can review/edit the worktree before continuing.
  pauseAfter Boolean          @default(false)

  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workflowId String

  // Branching: any step can have multiple children (e.g. several Condition
  // steps gating different sub-paths off the same parent). null = root step,
  // runs right after the trigger. Deleting a step cascades to its subtree.
  parentStep   WorkflowStep?  @relation("StepTree", fields: [parentStepId], references: [id], onDelete: Cascade)
  parentStepId String?
  childSteps   WorkflowStep[] @relation("StepTree")

  @@index([workflowId, order])
  @@index([parentStepId])
}

model WorkflowRun {
  id            String            @id @default(cuid())
  status        WorkflowRunStatus @default(pending)
  branchName    String?
  // Persisted so a paused (or crashed) run can reattach to the SAME
  // worktree directory instead of creating a fresh one — a fresh one
  // would only have whatever was already committed, losing any edits a
  // human made while the run was paused for review.
  worktreePath  String?
  prUrl         String?
  log           String            @default("")
  // JSON object mapping stepId -> "completed" | "pruned", used both to
  // resume a crashed run (skip whatever already ran) and to remember which
  // branches were pruned by a failed Condition (its subtree never runs, on
  // a fresh pass or a resumed one).
  stepStatuses  String            @default("{}")
  startedAt     DateTime          @default(now())
  finishedAt    DateTime?

  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workflowId String

  task       Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  taskId     String?

  // Chaining: a run can continue on the same branch/PR that a prior run
  // produced, instead of starting fresh from the project's default branch.
  parentRun   WorkflowRun?  @relation("RunChain", fields: [parentRunId], references: [id], onDelete: SetNull)
  parentRunId String?
  childRuns   WorkflowRun[] @relation("RunChain")

  @@index([workflowId])
  @@index([taskId])
  @@index([parentRunId])
}
